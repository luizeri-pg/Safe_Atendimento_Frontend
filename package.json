{
  "name": "safe-atendimento",
  "version": "1.0.0",
  "description": "Aplicação web frontend + backend para o sistema Safe Atendimento",
  "private": true,
  "type": "module",
  "main": "apps/backend/dist/index.js",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:apps",
    "build": "npm run build:apps",
    "start": "npm run start:apps",
    "dev:apps": "concurrently -k -n backend,frontend -c blue,green \"npm run dev -w @safe/backend\" \"npm run dev -w @safe/frontend\"",
    "build:apps": "npm run build -w @safe/frontend && npm run build -w @safe/backend",
    "start:apps": "npm run start -w @safe/backend",
    "dev:apps:backend": "npm run dev -w @safe/backend",
    "build:apps:backend": "npm run build -w @safe/backend",
    "dev:apps:frontend": "npm run dev -w @safe/frontend",
    "build:apps:frontend": "npm run build -w @safe/frontend"
  },
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizeri-pg/Safe_Atendimento_Frontend.git"
  },
  "keywords": [
    "safe-atendimento",
    "frontend",
    "hospital",
    "queue-management"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/luizeri-pg/Safe_Atendimento_Frontend/issues"
  },
  "homepage": "https://github.com/luizeri-pg/Safe_Atendimento_Frontend#readme",
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
