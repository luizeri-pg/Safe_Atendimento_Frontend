# Copie este arquivo para ".env" na raiz do projeto e preencha.
# Observação: o arquivo ".env" já está no .gitignore.

PORT=3000

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJ... (anon/publishable key)
# Recomendado: usado pelo backend para inserts server-side sem depender de policies permissivas
SUPABASE_SERVICE_ROLE_KEY=eyJ... (service_role key)

SAFE_SUPABASE_AUTH_DOMAIN=safe.local

# CORS (opcional; em produção com front+back no mesmo domínio pode deixar vazio)
SAFE_CORS_ORIGIN=http://localhost:5173

# SOC (opcional)
SOC_TIMEZONE=America/Sao_Paulo
SOC_EXPORT_URL=https://ws1.soc.com.br/WebSoc/exportadados
SOC_EMPRESA=
SOC_CODIGO=
SOC_CHAVE=
SOC_CODIGO_USUARIO_AGENDA=

